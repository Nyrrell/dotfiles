# Copier ce fichier en local.conf et adapter les valeurs à la machine.
# local.conf est ignoré par git.

# --- Système ---
LAN_SUBNET="192.168.1.0/24"
# Laisser vide : la question est posée une fois par make system, puis mémorisée ici.
ENABLE_WOL=""                                   # yes|no — Wake-on-LAN (filaire)
ENABLE_UFW=""                                   # yes|no — activer le pare-feu ufw
ENABLE_KEYCHRON=""                              # yes|no — règle udev Keychron (Launcher/VIA)

# --- Disques additionnels (fstab) ---
# format: "UUID|mountpoint|fstype|options"
# nofail garantit que le boot ne casse pas si le disque est absent (ex: laptop sans le disque)
# UUID via : lsblk -o NAME,UUID
EXTRA_MOUNTS=(
    # "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx|/data|ext4|nosuid,nodev,nofail,x-gvfs-show,x-udisks-auth"
    # "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx|/game|ext4|nosuid,nodev,nofail,x-gvfs-show,x-udisks-auth"
)

# --- Backup / NAS ---
BACKUP_HOST="CHANGEME"                          # hostname ou IP du NAS
NAS_REMOTE_PATH="/"                             # chemin distant monté sur ~/nas (défaut: /)
# Hors de chez soi : pas de SSH exposé sur Internet, activer le VPN (make wireguard).
BACKUP_USER="$(whoami)"
BACKUP_DEST="/raid/backups/$(hostname)"

BACKUP_DIRS=(
    "$HOME/.local/share/keyrings"
    "$HOME/.config/heroic"
    "$HOME/.config/lutris"
    "$HOME/.var/app/com.obsproject.Studio/config"
    # "$HOME/.hyperhdr/db"                       # optionnel : HyperHDR
)

# --- GOA Cal+Card (provider WebDAV) ---
GOA_USERNAME=""                                 # vide = skip ; nom d'utilisateur du serveur (≠ email selon le fournisseur)
GOA_URL=""                                      # ex: https://sync.infomaniak.com/

# --- Certificat LAN du serveur (make lan-ca) ---
# Racine des vhosts internes *.int, servie au LAN/VPN seulement. Vide = skip.
LAN_CA_URL=""                                   # ex: https://exemple.com/ca.crt

# --- VPN WireGuard (make wireguard) ---
# Connexion NetworkManager à activation manuelle : nmcli connection up "$WG_CONN_NAME"
# Ne pas l'activer à la maison : WG_ALLOWED_IPS contient le LAN, qui passerait par le tunnel.
WG_ENDPOINT=""                                  # vide = skip ; ex: vpn.exemple.com:51820
WG_CONN_NAME="Maison"                           # nom de la connexion NetworkManager
WG_IFACE="wg0"
WG_ADDRESS=""                                   # IP de CETTE machine dans le tunnel, ex: 10.100.0.2/32
WG_PEER_PUBKEY=""                               # clé PUBLIQUE du serveur (pas de secret ici)
WG_ALLOWED_IPS="192.168.1.0/24;10.100.0.0/24"   # séparées par ';'
WG_DNS=""                                       # ex: 10.100.0.1
WG_DNS_SEARCH=""                                # ex: ~exemple.com
WG_KEEPALIVE="25"
# Vide = nouvelle clé générée pour cette machine (sa clé publique est affichée,
# à ajouter sur le serveur). Sinon chemin d'un fichier contenant une clé privée existante.
WG_PRIVATE_KEY_FILE=""

# --- Paquets machine-specific ---
# Groupes optionnels (packages/groups/<nom>.conf) installés sur cette machine.
# Un groupe absent des deux listes est demandé une fois, puis la réponse est ajoutée ici.
PACKAGE_GROUPS=()                               # ex: (obs gaming)
PACKAGE_GROUPS_SKIP=()                          # groupes refusés sur cette machine
OPTIONAL_PACMAN_PACKAGES=()
OPTIONAL_AUR_PACKAGES=()                        # ex: (hyperhdr-git)
OPTIONAL_PREBUILT_PACKAGES=()                   # format: "pkgname|https://url/package.pkg.tar.zst"

OPTIONAL_FLATPAK_PACKAGES=()

# Extensions GNOME installées et activées sur CETTE machine seulement (en plus de
# gnome/extensions.txt). UUID via : gnome-extensions list --enabled
GNOME_EXTRA_EXTENSIONS=()                       # ex: (hidetopbar@mathieu.bidon.ca)

# --- Syncthing ---
SYNC_FOLDERS=(
    # format: "id|label|path|type|rescan_interval(optionnel, défaut 3600s)"
    "keepass|KeePass|$HOME/.local/keepass/bdd|sendreceive|10"
    "document|Documents|$HOME/Documents|sendreceive"
)

SYNC_INTRODUCERS=(
    "label|XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX"
)

# URL de l'UI Syncthing distante à ouvrir après config (vide = skip)
# Le serveur doit accepter le device ID local + les folders partagés.
SYNCTHING_REMOTE_URL=""                         # ex: https://syncthing.exemple.com/